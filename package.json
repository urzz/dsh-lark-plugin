{
  "name": "dsh-lark-plugin",
  "version": "0.1.0",
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/urzz/dsh-lark-plugin.git" },
  "homepage": "https://github.com/urzz/dsh-lark-plugin#readme",
  "bugs": { "url": "https://github.com/urzz/dsh-lark-plugin/issues" },
  "publishConfig": { "access": "public", "registry": "https://registry.npmjs.org" },
  "packageManager": "pnpm@10.34.9",
  "keywords": ["dsh", "cordis", "feishu", "lark", "sheets", "documents"],
  "description": "Feishu cloud documents, spreadsheets and Base through the official Lark CLI for DSH",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "icon": "./icon.svg",
  "exports": { ".": { "types": "./lib/types/index.d.ts", "default": "./lib/index.js" }, "./package.json": "./package.json", "./locale/*.json": "./locale/*.json", "./icon": "./icon.svg" },
  "files": ["lib", "skills", "locale", "icon.svg", "cordis.patch.yml", "README.md", "LICENSE"],
  "scripts": { "build": "tsc -p tsconfig.json", "typecheck": "tsc -p tsconfig.json --noEmit", "test": "pnpm build && node --test test/*.test.mjs", "check": "pnpm typecheck && pnpm test" },
  "engines": { "node": ">=22", "dsh": ">=0.2.1-rc.5 <0.3.0-0" },
  "dsh": { "bundle": { "patch": "./cordis.patch.yml" } },
  "dependencies": { "@deepseek-ai/schemastery": "~3.18.5" },
  "peerDependencies": { "@deepseek-ai/dsh-tools": ">=0.2.1-rc.5 <0.3.0-0", "@deepseek-ai/dsh-subprocess": ">=0.2.1-rc.5 <0.3.0-0" },
  "devDependencies": { "@deepseek-ai/dsh-tools": "0.2.1-rc.5", "@deepseek-ai/dsh-subprocess": "0.2.1-rc.5", "@types/node": "^22.0.0", "typescript": "^5.9.3" }
}
